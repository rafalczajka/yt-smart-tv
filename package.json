{
  "name": "yt-smart-tv",
  "version": "1.0.8",
  "scripts": {
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt zip --sources false",
    "build:firefox": "wxt zip -b firefox --sources false",
    "clean": "wxt clean",
    "test": "vitest run tests",
    "lint-staged": "lint-staged",
    "lint": "eslint . --ext .ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "wxt prepare && tsc -p .wxt/tsconfig.json",
    "postinstall": "wxt prepare && git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/svelte": "5.0.8",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "sass": "1.103.1",
    "svelte": "5.56.10",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}

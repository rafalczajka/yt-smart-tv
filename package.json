{
  "name": "yt-smart-tv",
  "scripts": {
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "run-p build:*",
    "build:chrome": "wxt zip --sources false",
    "build:firefox": "wxt zip -b firefox --sources false",
    "clean": "wxt clean",
    "test": "vitest run tests",
    "lint-staged": "lint-staged",
    "lint": "eslint . --ext .ts",
    "format": "prettier **/*.ts --write",
    "typecheck": "wxt prepare && tsc -p .wxt/tsconfig.json",
    "postinstall": "wxt prepare && git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/svelte": "5.0.8",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "lint-staged": "17.0.8",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.4",
    "sass": "1.101.0",
    "svelte": "5.56.4",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9",
    "wxt": "0.20.27"
  }
}

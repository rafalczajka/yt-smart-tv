{
  "name": "yt-smart-tv",
  "version": "1.1.0",
  "scripts": {
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt zip --sources false",
    "build:firefox": "wxt zip -b firefox --sources false",
    "clean": "wxt clean",
    "test": "vitest run tests",
    "lint-staged": "lint-staged",
    "lint": "eslint . --ext .ts,.svelte",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare && git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "prettier --write",
      "eslint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sass": "1.107.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
